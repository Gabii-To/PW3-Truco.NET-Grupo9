@{
    ViewData["Title"] = "Home Page";
}

<!-- Encabezado / Navbar -->


<!-- Contenido Principal -->
<main class="container my-5">

    <!-- Hero Section / Bienvenida -->
    <div class="container-bar text-center py-5 mb-5">
        <h1 class="titulo-bar display-3 fw-bold mb-3">
            EL MEJOR LUGAR PARA JUGAR AL <span class="subtitulo-neon">TRUCO</span>
        </h1>
        <p class="lead text-light opacity-75 col-md-8 mx-auto">
            Pasá, sentate en la mesa y pedí un trago. Acá se juega al truco posta: mentiras, retruco, envido y señas con tus compañeros. Sin vueltas ni vueltas.
        </p>
        <div class="mt-4">
            <button class="btn btn-bar btn-lg px-4 me-2" data-bs-toggle="modal" data-bs-target="#loginModal">
                Jugar Ahora
            </button>
            <a href="#modalidades" class="btn btn-outline-light btn-lg px-4">
                Ver Modalidades
            </a>
        </div>
    </div>

    <!-- Sección de Modalidades de Juego -->
    <section id="modalidades" class="my-5">
        <h2 class="text-center subtitulo-neon mb-4 fs-1">ELEGÍ TU MESA</h2>

        <div class="row g-4">
            <!-- Tarjeta 1v1 -->
            <div class="col-md-6">
                <div class="mesa-truco h-100 d-flex flex-column justify-content-between p-4">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="fw-bold text-white mb-0">MANO A MANO (1 vs 1)</h3>
                            <span class="badge bg-warning text-dark fs-6">2 Jugadores</span>
                        </div>
                        <p class="text-light opacity-75">
                            El duelo clásico. Medite cara a cara contra otro jugador en un mano a mano donde la astucia, el faroleo y saber cuándo irse al mazo lo son todo.
                        </p>
                        <ul class="list-unstyled small text-warning">
                            <li>✔ Partidas a 15 o 30 puntos</li>
                            <li>✔ Rápido y dinámico</li>
                            <li>✔ Ideal para probar tus señas y estrategias</li>
                        </ul>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-bar w-100">Crear Mesa 1v1</button>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 2v2 -->
            <div class="col-md-6">
                <div class="mesa-truco h-100 d-flex flex-column justify-content-between p-4">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="fw-bold text-white mb-0">EN PAREJAS (2 vs 2)</h3>
                            <span class="badge bg-danger fs-6">4 Jugadores</span>
                        </div>
                        <p class="text-light opacity-75">
                            El truco de cantina tradicional. Armá equipo con un amigo o sumate a una mesa pública para jugar en parejas coordinando señas y estrategias.
                        </p>
                        <ul class="list-unstyled small text-danger">
                            <li>✔ Sistema de señas a tu compañero</li>
                            <li>✔ Trabajo en equipo para cantar el Envido</li>
                            <li>✔ La verdadera experiencia del truco argentino</li>
                        </ul>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-bar-danger w-100">Crear Mesa 2v2</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Banner Informativo -->
    <div class="anotador-truco text-center my-5 p-4">
        <h4 class="text-warning mb-2">¿SOS NUEVO EN LA CANTINA?</h4>
        <p class="mb-0 text-light opacity-75">
            Registrate gratis en segundos para guardar tus estadísticas, acumular puntos en el ranking de la semana y armar mesas privadas con tus amigos.
        </p>
    </div>

</main>

<!-- Pie de página -->

<!-- Modales de Login y Registro se incluyen dinámicamente -->
@* <partial name="_LoginModalPartial" /> *@
@* <partial name="_RegisterModalPartial" /> *@